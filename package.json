{
  "name": "key-overlay",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that shows pressed keys and clicks as a floating overlay, per tab.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run lint && npm run test:static && npm run test:unit && npm run test:e2e",
    "test:unit": "node --test 'test/unit/*.test.js'",
    "test:static": "node --test 'test/static/*.test.js'",
    "test:e2e": "playwright test",
    "lint": "eslint src",
    "fixtures": "node test/server.js",
    "package": "npm test && node scripts/package.js",
    "icons": "node scripts/make-icons.js",
    "screenshots": "node scripts/make-screenshots.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.0",
    "globals": "^17.0.0"
  }
}
